# Copy to .env.local for local development. Never commit real values.
# In production these are set in the hosting service's settings, not in files.

# First-time setup only: the Owners to create when the app has no users yet.
SEED_OWNERS="Kale <kale@example.com>, Casey <casey@example.com>"

# Postgres connection address. Leave unset locally to use the built-in
# development database (stored in .data/, nothing to install).
# DATABASE_URL=

# The app's public address, used in sign-in emails. Required in production.
# APP_URL=https://manual.example.com

# Email service (Resend). Leave unset locally: sign-in links are then printed
# in the terminal and saved in .data/outbox instead of being emailed.
# RESEND_API_KEY=
# EMAIL_FROM="Plant Perfect Fargo <manual@example.com>"
